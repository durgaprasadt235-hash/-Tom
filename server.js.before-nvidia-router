// --------------------------------------------------
// CONTROLLED EXECUTION ENDPOINT
// --------------------------------------------------

app.post("/execute", async (req, res) => {
  try {
    const { command } = req.body;

    if (!command || typeof command !== "string") {
      return res.status(400).json({
        error: "Command is required"
      });
    }

    const result = await executeControlledCommand(command);
    
    res.json({
      project: "DROP",
      ...result
    });
  } catch (error) {
    // Check if it's a validation error (400) or execution error (500)
    if (error.message.includes("not allowed") || 
        error.message.includes("required") || 
        error.message.includes("operator") ||
        error.message.includes("empty")) {
      return res.status(400).json({
        error: error.message
      });
    }
    
    res.status(500).json({
      error: error.message
    });
  }
});

// --------------------------------------------------
// CONTROLLED FILE WRITE ENDPOINT
// --------------------------------------------------

app.post("/file/write", async (req, res) => {
  try {
    const { path, content } = req.body;

    if (!path || typeof path !== "string") {
      return res.status(400).json({
        error: "File path is required"
      });
    }

    if (content === undefined) {
      return res.status(400).json({
        error: "Content is required"
      });
    }

    const result = await writeProjectFile(path, content);
    
    res.json({
      project: "DROP",
      ...result
    });
  } catch (error) {
    // Check if it's a validation error (400) or write error (500)
    if (error.message.includes("not allowed") || 
        error.message.includes("required") || 
        error.message.includes("outside") ||
        error.message.includes("directory") ||
        error.message.includes("symlink") ||
        error.message.includes("size")) {
      return res.status(400).json({
        error: error.message
      });
    }
    
    res.status(500).json({
      error: error.message
    });
  }
});

