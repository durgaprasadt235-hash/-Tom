app.get("/file", (req, res) => {
  try {
    const filePath =
      req.query.path;

    if (!filePath) {
      return res
        .status(400)
        .json({
          error:
            "File path is required"
        });
    }

    const content =
      readProjectFile(filePath);

    res.json({
      project: "DROP",
      path: filePath,
      content
    });

  } catch (error) {
    res.status(400).json({
      error: error.message
    });
  }
});

// --------------------------------------------------
// HEALTH CHECK
// --------------------------------------------------

app.get("/health", (req, res) => {
  try {
    // Test DROP project accessibility by trying to read the project root
    let dropAccessible = false;
    let dropError = null;
    try {
      const files = listProjectFiles();
      dropAccessible = files.length >= 0; // Even empty array means accessible
    } catch (error) {
      dropError = error.message;
    }
    
    // Test OmniRoute connectivity (simple DNS/resolution check, not actual call)
    let omniRouteStatus = "unknown";
    try {
      // We won't actually call OmniRoute here to avoid dependencies in health check
      // Just check if the URL is configured
      if (OMNIROUTE_URL && typeof OMNIROUTE_URL === "string") {
        omniRouteStatus = "configured";
      } else {
        omniRouteStatus = "misconfigured";
      }
    } catch (error) {
      omniRouteStatus = "error";
    }
    
    const metricsData = getMetrics();
    
    res.json({
      status: "ok",
      agent: "Tom",
      project: "DROP",
      dropProject: {
        accessible: dropAccessible,
        error: dropError,
        path: DROP_ROOT
      },
      omniRoute: {
        status: omniRouteStatus,
        url: OMNIROUTE_URL
      },
      uptime: metricsData.uptime,
      activeRequests: metricsData.activeRequests
    });
  } catch (error) {
    res.status(500).json({
      status: "error",
      agent: "Tom",
      project: "DROP",
      error: error.message
    });
  }
});

