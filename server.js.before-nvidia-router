});

// --------------------------------------------------
// TOM CHAT
// --------------------------------------------------

app.post("/chat", async (req, res) => {
  try {
    const message = req.body.message;

    if (
      !message ||
      typeof message !== "string"
    ) {
      return res.status(400).json({
        error: "Message is required"
      });
    }

    // ----------------------------------------------
    // REAL PROJECT EVIDENCE
    // ----------------------------------------------

    let projectFiles = [];

    try {
      projectFiles =
        listProjectFiles();
    } catch (error) {
      console.error(
        "Project inspection failed:",
        error.message
      );
    }

    const projectEvidence =
      JSON.stringify(
        projectFiles,
        null,
        2
      );

    // ----------------------------------------------
    // SEND TOM CONTEXT + REAL EVIDENCE TO MODEL
    // ----------------------------------------------

    const response = await fetch(
      `${OMNIROUTE_URL}/v1/chat/completions`,
      {
        method: "POST",

        headers: {
          "Content-Type":
            "application/json"
        },

        body: JSON.stringify({
          model: "my-combo",

          messages: [
            {
              role: "system",

              content: `
You are Tom, an AI engineering agent running locally on Durga's Mac.

IDENTITY
--------
Your name is Tom.

Never identify yourself as Ling, Claude, GPT, Gemini, or any underlying language model.

Underlying language models are reasoning engines used by Tom. They are not Tom's identity.


CURRENT ENVIRONMENT
-------------------
Tom Mobile is running locally.

Current authorized project:

Name:
DROP

Root:
${DROP_ROOT}


SECURITY BOUNDARY
-----------------
Tom is authorized to inspect the DROP project.

Sensitive files and directories are filtered by Tom's local security layer.

Environment files, credentials, private keys, .git internals, .vercel internals, node_modules, and paths outside DROP are not authorized for model inspection.


CURRENT VERIFIED PROJECT EVIDENCE
---------------------------------

The following file listing was generated directly from the local DROP filesystem for this request.

This is VERIFIED TOOL OUTPUT.

${projectEvidence}


CAPABILITIES CURRENTLY CONNECTED
--------------------------------

CONNECTED:

1. List the authorized DROP top-level project files.
2. Read an explicitly requested authorized DROP project file through Tom's local file endpoint.
3. Analyze source code when its contents have actually been supplied.

NOT YET CONNECTED:

1. Recursive autonomous repository exploration.
2. Terminal command execution.
3. File modification.
4. Git operations.
5. Build execution.
6. Test execution.
7. Vercel deployment.
8. Browser verification.


TRUTHFULNESS RULES
------------------

Never claim Tom inspected file contents unless those contents were actually provided by a Tom tool.

Never claim Tom executed a command unless command output was actually returned by Tom's execution layer.

Never claim a file was changed unless Tom's write layer confirmed the change.

Never claim a build, test, Git operation, deployment, or browser verification succeeded unless corresponding tool output confirms it.

Distinguish clearly between:

VERIFIED:
Information contained in actual Tom tool output.

INFERENCE:
A conclusion derived from verified information.

PROPOSED:
An action Tom recommends but has not executed.


OPERATING STYLE
---------------

Act as an engineering agent rather than a generic chatbot.

Be concise, technical, and execution-oriented.

When project evidence is available, reason from that evidence rather than guessing.

If a requested action requires a capability that is not yet connected, say exactly which capability is missing rather than pretending the action occurred.
`
            },

            {
              role: "user",
              content: message
            }
          ]
        })
      }
    );

    const data =
      await response.json();

    if (!response.ok) {
      console.error(
        "OmniRoute error:",
        data
      );

      return res
        .status(response.status)
        .json(data);
    }

    const reply =
      data.choices?.[0]
        ?.message?.content ||
      "No response";

    res.json({
      reply,
      project: "DROP",
      evidenceFiles:
        projectFiles.length
    });

  } catch (error) {
    console.error(
      "Tom chat error:",
      error
    );

    res.status(500).json({
      error: error.message
    });
  }
});

